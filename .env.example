# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=matterbridge-ai-plugin-factory

# Claude Code CLI Authentication
# Run "claude login" to authenticate with your Pro plan

# Factory Configuration
PLUGINS_OUTPUT_DIR=./plugins
ARTIFACTS_DIR=./artifacts
MAX_CONCURRENT_BUILDS=2

# Batch runner (src/process-batch.js) — hourly cron recommended
# FACTORY_MAX_RUNTIME_MS=16200000      # 4.5h — stop before Claude 5h window ends
# FACTORY_MIN_JOB_MS=2700000           # 45min — don't start a job if less time remains
# FACTORY_MAX_PLUGINS=6                # max plugins per batch run
# FACTORY_PAUSE_DURATION_MS=18000000   # 5h pause after credit exhaustion
# FACTORY_STALE_IN_PROGRESS_MS=10800000 # recover stuck in-progress after 3h
# FACTORY_LOCK_STALE_MS=21600000       # take over lock after 6h

# Webhook Configuration (optional, for GitHub webhook integration)
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_PORT=3000

# Telegram notifications (optional)
# Create a bot via @BotFather and get your chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
