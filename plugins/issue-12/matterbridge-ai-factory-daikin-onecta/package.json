{
  "name": "matterbridge-ai-factory-daikin-onecta",
  "version": "0.1.0",
  "description": "Matterbridge plugin for Daikin Onecta cloud (BRP069C4x) air conditioners",
  "author": "Matterbridge AI Factory",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "files": [
    "dist",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "npx shx rm -rf *.tsbuildinfo dist",
    "cleanBuild": "npm run clean && npm run build",
    "dev:link": "npm link --no-fund --no-audit matterbridge",
    "matterbridge:add": "matterbridge -add .",
    "matterbridge:remove": "matterbridge -remove ."
  },
  "dependencies": {
    "daikin-controller-cloud": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "shx": "0.4.0",
    "typescript": "5.6.3"
  }
}
