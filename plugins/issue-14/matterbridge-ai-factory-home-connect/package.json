{
  "name": "matterbridge-ai-factory-home-connect",
  "version": "1.0.0",
  "description": "Matterbridge Home Connect plugin: exposes BSH/Bosch/Siemens/NEFF/Gaggenau appliances via the Home Connect cloud API.",
  "author": "matterbridge-ai-factory",
  "license": "Apache-2.0",
  "homepage": "https://github.com/matterbridge-ai-factory/matterbridge-ai-factory-home-connect",
  "private": true,
  "keywords": [
    "matterbridge",
    "plugin",
    "home-connect",
    "bosch",
    "siemens",
    "neff",
    "gaggenau",
    "matter",
    "smarthome"
  ],
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "start": "matterbridge",
    "build": "tsc --project tsconfig.build.json",
    "clean": "npx shx rm -rf *.tsbuildinfo dist",
    "cleanBuild": "npm run clean && npm run build",
    "watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev:link": "npm link --no-fund --no-audit matterbridge",
    "matterbridge:add": "matterbridge -add .",
    "matterbridge:remove": "matterbridge -remove .",
    "matterbridge:enable": "matterbridge -enable .",
    "matterbridge:disable": "matterbridge -disable ."
  },
  "dependencies": {
    "node-ansi-logger": "3.2.1",
    "node-persist-manager": "2.0.2"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "shx": "0.4.0",
    "typescript": "6.0.3"
  }
}
