{
  "name": "matterbridge-ai-factory-yoto-player-cloud-api",
  "version": "1.0.0",
  "description": "Matterbridge plugin for Yoto Player via the Yoto Cloud API",
  "author": "Gladys Assistant <hello@gladysassistant.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gladysassistant/matterbridge-ai-factory-yoto-player-cloud-api",
  "keywords": [
    "matterbridge",
    "plugin",
    "yoto",
    "yotoplayer",
    "matter",
    "matter.js",
    "iot",
    "smarthome",
    "gladysassistant"
  ],
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "start": "matterbridge",
    "build": "tsc --project tsconfig.build.json",
    "clean": "npx shx rm -rf *.tsbuildinfo dist",
    "cleanBuild": "npm run clean && npm run build",
    "watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev:link": "npm link --no-fund --no-audit matterbridge",
    "matterbridge:add": "matterbridge -add .",
    "matterbridge:remove": "matterbridge -remove .",
    "matterbridge:enable": "matterbridge -enable .",
    "matterbridge:disable": "matterbridge -disable ."
  },
  "dependencies": {
    "mqtt": "^5.15.1",
    "node-ansi-logger": "3.2.1",
    "node-persist-manager": "2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "shx": "^0.4.0",
    "typescript": "^5.6.3"
  }
}
